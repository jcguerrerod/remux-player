<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tvos_canvas_bg">

    <!-- MAIN CANVAS -->
    <FrameLayout
        android:id="@+id/mainContentBlurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- FULLSCREEN CINEMATIC 4K BACKDROP -->
        <ImageView
            android:id="@+id/ivHeroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Cinematic Background 1" />

        <ImageView
            android:id="@+id/ivHeroBackdropAlt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:contentDescription="Cinematic Background 2" />

        <!-- CINEMATIC APPLE TV+ BOTTOM SCRIM GRADIENT -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_apple_tv_hero_scrim" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <!-- ULTRA-MINIMAL SYMMETRICAL TOP NAV (Centered tvOS 18 segmented dock) -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_tvos_nav_dock"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnTabMovies"
                    android:layout_width="102dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_tvos_nav_text_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:nextFocusDown="@+id/btnPlayDirect"
                    android:nextFocusRight="@+id/btnTabShows"
                    android:text="Movies"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/btnTabShows"
                    android:layout_width="102dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_tvos_nav_text_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:nextFocusDown="@+id/btnPlayDirect"
                    android:nextFocusLeft="@+id/btnTabMovies"
                    android:nextFocusRight="@+id/serverBadge"
                    android:text="TV Shows"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/serverBadge"
                    android:layout_width="102dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_tvos_nav_text_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@+id/btnPlayDirect"
                    android:nextFocusLeft="@+id/btnTabShows">

                    <View
                        android:id="@+id/serverStatusDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_card_watched_badge"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvServerInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Settings"
                        android:textColor="@color/apple_btn_text_selector"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DISEÑO 11: APPLE TV+ CENTERED CINEMA HERO -->
            <FrameLayout
                android:id="@+id/heroAreaContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/topBar"
                android:layout_above="@id/bottomShelfSection"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/heroContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Centered Graphical ClearLogo -->
                    <ImageView
                        android:id="@+id/ivHeroLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxHeight="92dp"
                        android:maxWidth="460dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:layout_marginBottom="6dp"
                        android:contentDescription="Movie Logo" />

                    <!-- Centered Bold Title Fallback -->
                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="PROJECT HAIL MARY"
                        android:textColor="@color/tvos_text_primary"
                        android:textSize="34sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.03"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="12" />

                    <!-- Centered 1-Line Apple TV+ Metadata + Official Dolby / 4K Marks -->
                    <LinearLayout
                        android:id="@+id/llBadgesRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeroGenre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:text="Sci-Fi  ·  2026  ·  2h 18m"
                            android:textColor="@color/tvos_text_secondary"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#B0000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="6" />

                        <ImageView
                            android:id="@+id/ivHeroResolution"
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_marginStart="11dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_4k"
                            android:visibility="gone"
                            android:contentDescription="Resolution" />

                        <TextView
                            android:id="@+id/badgeResolution"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_badge_apple_resolution"
                            android:paddingStart="5.5dp"
                            android:paddingEnd="5.5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="4K"
                            android:textColor="#18181E"
                            android:textSize="9.5sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivHeroDolbyVision"
                            android:layout_width="wrap_content"
                            android:layout_height="15dp"
                            android:layout_marginStart="9dp"
                            android:alpha="0.90"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_dolby_vision"
                            android:visibility="gone"
                            android:contentDescription="Dynamic Range" />

                        <TextView
                            android:id="@+id/badgeHdr"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_cinema_outline"
                            android:paddingStart="5.5dp"
                            android:paddingEnd="5.5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="HLG"
                            android:textColor="#D8FFFFFF"
                            android:textSize="9.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivHeroAudioCarrier"
                            android:layout_width="wrap_content"
                            android:layout_height="13.5dp"
                            android:layout_marginStart="9dp"
                            android:alpha="0.90"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_dolby_truehd"
                            android:visibility="gone"
                            android:contentDescription="Audio Codec Carrier" />

                        <ImageView
                            android:id="@+id/ivHeroDolbyAtmos"
                            android:layout_width="wrap_content"
                            android:layout_height="15dp"
                            android:layout_marginStart="9dp"
                            android:alpha="0.90"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_dolby_atmos"
                            android:visibility="gone"
                            android:contentDescription="Audio Format" />

                        <TextView
                            android:id="@+id/badgeAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_cinema_outline"
                            android:paddingStart="5.5dp"
                            android:paddingEnd="5.5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="FLAC"
                            android:textColor="#D8FFFFFF"
                            android:textSize="9.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/badgeChannels"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_cinema_outline"
                            android:paddingStart="5.5dp"
                            android:paddingEnd="5.5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="7.1"
                            android:textColor="#D8FFFFFF"
                            android:textSize="9.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Centered Clean 10dp Squircle Primary CTA (Exact Diseño 11) -->
                    <Button
                        android:id="@+id/btnPlayDirect"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:minWidth="156dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_apple_tv_pill_primary"
                        android:drawableStart="@drawable/ic_play_arrow"
                        android:drawableTint="@color/apple_primary_btn_text_selector"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="Play"
                        android:textColor="@color/apple_primary_btn_text_selector"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-bold"
                        android:textAllCaps="false"
                        android:paddingStart="46dp"
                        android:paddingEnd="46dp"
                        android:elevation="8dp"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btnTabMovies"
                        android:nextFocusDown="@+id/btnCheck" />

                    <!-- Centered Minimal Ghost Secondary Actions Directly Below Play (Exact Diseño 11) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCheck"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_watched_toggle_button"
                            android:drawableStart="@drawable/ic_check"
                            android:drawableTint="@color/watched_btn_tint_selector"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Mark Watched"
                            android:textColor="@color/apple_btn_text_selector"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:focusable="true"
                            android:nextFocusUp="@+id/btnPlayDirect"
                            android:nextFocusRight="@+id/btnDetails"
                            android:nextFocusDown="@+id/shelfScrollView" />

                        <Button
                            android:id="@+id/btnDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tvos_nav_text_tab"
                            android:drawableStart="@drawable/ic_info"
                            android:drawableTint="@color/apple_btn_tint_selector"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Details"
                            android:textColor="@color/apple_btn_text_selector"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:focusable="true"
                            android:nextFocusUp="@+id/btnPlayDirect"
                            android:nextFocusLeft="@+id/btnCheck"
                            android:nextFocusRight="@+id/btnRestart"
                            android:nextFocusDown="@+id/shelfScrollView" />

                        <Button
                            android:id="@+id/btnRestart"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tvos_nav_text_tab"
                            android:drawableStart="@drawable/ic_restart"
                            android:drawableTint="@color/apple_btn_tint_selector"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Restart"
                            android:textColor="@color/apple_btn_text_selector"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:focusable="true"
                            android:nextFocusUp="@+id/btnPlayDirect"
                            android:nextFocusLeft="@+id/btnDetails"
                            android:nextFocusDown="@+id/shelfScrollView"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- HORIZONTAL BOTTOM SHELF OF WIDESCREEN 16:9 CARDS (10dp Squircle Corners) -->
            <LinearLayout
                android:id="@+id/bottomShelfSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/shelfScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fadeScrollbars="false"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="none"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/llCardShelf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- ========================================================================= -->
    <!-- PANORAMIC tvOS BOTTOM DRAWER: EPISODES (16:9 Thumbnails + Seasons)        -->
    <!-- ========================================================================= -->
    <FrameLayout
        android:id="@+id/episodesModalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6605070C"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <com.player.androidtv.ui.LiquidGlassLayout
            android:id="@+id/episodesModalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_tvos_bottom_drawer"
            android:elevation="28dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivEpisodesModalLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxHeight="42dp"
                        android:maxWidth="260dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:visibility="gone"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="Series Logo" />

                    <TextView
                        android:id="@+id/tvEpisodesSeriesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="SEVERANCE"
                        android:textColor="@color/tvos_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvEpisodesSeriesMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Select Season &amp; Episode"
                        android:textColor="@color/tvos_text_tertiary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/seasonsScrollView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llSeasonsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <ScrollView
                android:id="@+id/episodesScrollView"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                android:layout_marginTop="14dp"
                android:scrollbars="none"
                android:fadeScrollbars="false"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/llEpisodesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </com.player.androidtv.ui.LiquidGlassLayout>
    </FrameLayout>

    <!-- ========================================================================= -->
    <!-- PANORAMIC tvOS BOTTOM DRAWER: MOVIE DETAILS                               -->
    <!-- ========================================================================= -->
    <FrameLayout
        android:id="@+id/detailsModalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6605070C"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <com.player.androidtv.ui.LiquidGlassLayout
            android:id="@+id/detailsModalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_tvos_bottom_drawer"
            android:elevation="28dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivDetailsModalLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxHeight="46dp"
                        android:maxWidth="280dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:visibility="gone"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="Movie Logo" />

                    <TextView
                        android:id="@+id/tvDetailsModalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="Title"
                        android:textColor="@color/tvos_text_primary"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/tvDetailsModalSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="2024  ·  4K UHD"
                        android:textColor="@color/tvos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDetailsPlayNow"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_apple_tv_pill_primary"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:drawableTint="@color/apple_primary_btn_text_selector"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Play Direct Stream"
                    android:textAllCaps="false"
                    android:textColor="@color/apple_primary_btn_text_selector"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.35"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailsSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3.5dp"
                        android:textColor="@color/tvos_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailsCrew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/tvos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_apple_tv_detail_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06"
                            android:text="VIDEO"
                            android:textColor="@color/tvos_text_tertiary"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvDetailsVideoSpec"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="4K UHD · Dolby Vision"
                            android:textColor="@color/tvos_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_apple_tv_detail_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06"
                            android:text="AUDIO"
                            android:textColor="@color/tvos_text_tertiary"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvDetailsAudioSpec"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Dolby Atmos · 7.1"
                            android:textColor="@color/tvos_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_apple_tv_detail_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06"
                            android:text="FILE"
                            android:textColor="@color/tvos_text_tertiary"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvDetailsFileSpec"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Direct Play"
                            android:textColor="@color/tvos_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.player.androidtv.ui.LiquidGlassLayout>
    </FrameLayout>

    <!-- ========================================================================= -->
    <!-- JELLYFIN SERVER CONNECTION SHEET                                          -->
    <!-- ========================================================================= -->
    <FrameLayout
        android:id="@+id/connectModalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6605070C"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <com.player.androidtv.ui.LiquidGlassLayout
            android:id="@+id/connectModalCard"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_tvos_bottom_drawer"
            android:elevation="28dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="Jellyfin Server"
                android:textColor="@color/tvos_text_primary"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvConnectSecurityHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="LAN Direct Play · Tokens sealed via Android Keystore"
                android:textColor="@color/tvos_text_tertiary"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="SERVER URL"
                android:textColor="@color/tvos_text_tertiary"
                android:textSize="10.5sp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_apple_tv_input"
                android:fontFamily="sans-serif"
                android:hint="http://192.168.100.108:8096"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:nextFocusDown="@+id/etUsername"
                android:singleLine="true"
                android:textColor="@color/tvos_text_primary"
                android:textColorHint="@color/tvos_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="USERNAME"
                android:textColor="@color/tvos_text_tertiary"
                android:textSize="10.5sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_apple_tv_input"
                android:fontFamily="sans-serif"
                android:hint="Username"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:nextFocusDown="@+id/etPassword"
                android:nextFocusUp="@+id/etServerUrl"
                android:singleLine="true"
                android:textColor="@color/tvos_text_primary"
                android:textColorHint="@color/tvos_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="PASSWORD"
                android:textColor="@color/tvos_text_tertiary"
                android:textSize="10.5sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_apple_tv_input"
                android:fontFamily="sans-serif"
                android:hint="Optional for passwordless local accounts"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:nextFocusDown="@+id/btnConnectSubmit"
                android:nextFocusUp="@+id/etUsername"
                android:singleLine="true"
                android:textColor="@color/tvos_text_primary"
                android:textColorHint="@color/tvos_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConnectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FF6961"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnConnectDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_apple_tv_pill_danger"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:nextFocusRight="@+id/btnConnectSubmit"
                    android:nextFocusUp="@+id/etPassword"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnConnectSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_apple_tv_pill_primary"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:nextFocusLeft="@+id/btnConnectDisconnect"
                    android:nextFocusUp="@+id/etPassword"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="@color/apple_primary_btn_text_selector"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.player.androidtv.ui.LiquidGlassLayout>
    </FrameLayout>

    <!-- tvOS 18 Split View Settings Overlay (Diseño S1) -->
    <include
        android:id="@+id/settingsInclude"
        layout="@layout/view_settings_overlay" />

</FrameLayout>

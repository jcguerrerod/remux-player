<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090E">

    <!-- FULLSCREEN CINEMATIC HERO BACKDROP (Smooth Apple TV Crossfade) -->
    <ImageView
        android:id="@+id/ivHeroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Cinematic Background 1" />

    <ImageView
        android:id="@+id/ivHeroBackdropAlt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="Cinematic Background 2" />

    <!-- CINEMATIC APPLE TV+ SCRIM GRADIENT -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_apple_tv_hero_scrim" />

    <!-- CONTENEDOR PRINCIPAL DE CONTENIDOS -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!-- CABECERA SUTIL: LOGO REMUX PLAYER Y ESTADO SERVIDOR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMUX"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="PLAYER"
                    android:textColor="#8E8E93"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Badge Servidor Jellyfin (Oculto para limpieza visual Apple TV) -->
            <LinearLayout
                android:id="@+id/serverBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_apple_tv_badge"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_badge_directplay" />

                <TextView
                    android:id="@+id/tvServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Jellyfin Guerrero · 192.168.100.108"
                    android:textColor="#D1D1D6"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- MOVIE SYNOPSIS AND INFO SECTION (Apple TV Style) -->
        <LinearLayout
            android:id="@+id/heroContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:layout_above="@id/bottomShelfSection"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left Column: Title, Genre, Synopsis, Badges, and Action Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.0"
                android:orientation="vertical">

                <!-- Apple TV Bold Uppercase Title -->
                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RAIDERS OF THE LOST ARK"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03" />

                <!-- Genre and Release Year Row -->
                <TextView
                    android:id="@+id/tvHeroGenre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:text="Movie  ·  Action  ·  Adventure  ·  1981"
                    android:textColor="#A1A1A6"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <!-- 3-line Synopsis -->
                <TextView
                    android:id="@+id/tvHeroSynopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:text="Archaeology professor Indiana Jones ventures across the globe to uncover the legendary Ark of the Covenant before insidious Nazi forces can seize its ancient power."
                    android:textColor="#C7C7CC"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <!-- Fila de Metadatos y Logos Oficiales (Foto 4 Apple TV) -->
                <LinearLayout
                    android:id="@+id/llBadgesRow"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMetadataText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1981  ·  1h 55m  ·  56.73 GB Remux"
                        android:textColor="#D1D1D6"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Resolution Pill: 4K or HD -->
                    <TextView
                        android:id="@+id/badgeResolution"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_apple_tv_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="4K"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.06" />

                    <!-- HDR / Dolby Vision Pill -->
                    <TextView
                        android:id="@+id/badgeHdr"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_apple_tv_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="DOLBY VISION"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <!-- Source Format Pill: BLU-RAY -->
                    <TextView
                        android:id="@+id/badgeSource"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_apple_tv_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="BLU-RAY"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <!-- Audio Codec Pill: DOLBY ATMOS / DTS-HD MA / DOLBY AUDIO / TRUEHD -->
                    <TextView
                        android:id="@+id/badgeAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_apple_tv_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="DOLBY ATMOS"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <!-- Audio Channels Pill: 5.1 / 7.1 -->
                    <TextView
                        android:id="@+id/badgeChannels"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_apple_tv_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="7.1"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <!-- Main Apple TV Action Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Primary White Apple TV Pill: Play with Icon and Duration -->
                    <Button
                        android:id="@+id/btnPlayDirect"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_apple_tv_pill_primary"
                        android:drawableStart="@drawable/ic_play_arrow"
                        android:drawableTint="@color/apple_btn_text_selector"
                        android:drawablePadding="8dp"
                        android:text="1h 55m"
                        android:textColor="@color/apple_btn_text_selector"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:focusable="true"
                        android:nextFocusDown="@+id/shelfScrollView" />

                    <!-- Circular Checkmark Button -->
                    <ImageButton
                        android:id="@+id/btnCheck"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_check"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@+id/shelfScrollView"
                        android:contentDescription="In Watchlist" />

                    <!-- Circular Info Button -->
                    <ImageButton
                        android:id="@+id/btnDetails"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_info"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@+id/shelfScrollView"
                        android:contentDescription="More Info" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column: Cast and Director -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroCast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cast  Harrison Ford, Karen Allen, Paul Freeman, John Rhys-Davies"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvHeroDirector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Director  Steven Spielberg"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- HORIZONTAL BOTTOM SHELF OF WIDESCREEN APPLE TV POSTER CARDS -->
        <LinearLayout
            android:id="@+id/bottomShelfSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movies"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:letterSpacing="0.04"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <HorizontalScrollView
                android:id="@+id/shelfScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:requiresFadingEdge="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/llCardShelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episodeRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_apple_tv_sheet_row"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 16:9 Widescreen Episode Still Thumbnail (tvOS Style) -->
    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardBackgroundColor="#202430"
        android:clipToOutline="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvEpisodeThumbFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="EP 1"
                android:textColor="@color/tvos_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05" />

            <ImageView
                android:id="@+id/ivEpisodeThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Episode Thumbnail" />

            <!-- Watched Checkmark Badge (Top-Right of Episode Thumbnail) -->
            <FrameLayout
                android:id="@+id/epWatchedBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_card_watched_badge"
                android:visibility="gone">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:tint="@color/tvos_ink_dark"
                    android:contentDescription="Watched" />
            </FrameLayout>

            <!-- Inset Rounded White Progress Bar Inside 16:9 Thumbnail -->
            <FrameLayout
                android:id="@+id/epProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="5dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_track_tvos" />

                <View
                    android:id="@+id/epProgressFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_fill_tvos" />
            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Right Column: Title, Tonal Metadata Row, and 2-Line Synopsis -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEpisodeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tvos_text_primary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvEpisodeSpecs"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_apple_tv_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/tvos_text_primary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEpisodeOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tvos_text_secondary"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:lineSpacingExtra="1.5dp"
            android:ellipsize="end"
            android:paddingTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

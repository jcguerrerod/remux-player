<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPlaybackContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- NATIVE VIDEO SURFACE (MediaCodec Hardware Surface) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- APPLE TV+ / tvOS MINIMAL HUD OVERLAY -->
    <RelativeLayout
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APPLE TV SUBTLE TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_top_gradient"
            android:paddingStart="48dp"
            android:paddingTop="28dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <!-- 40dp Circular Back Button (Zero scale zoom) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_apple_tv_circle_button"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/apple_btn_tint_selector"
                android:focusable="true"
                android:nextFocusDown="@id/timelineSeekBar"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvTopHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text=""
                android:textColor="@color/tvos_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06" />

            <!-- Apple TV Unified Pure White Cinema Logos (Box-Free) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivPlayerResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo_4k"
                    android:visibility="gone"
                    android:contentDescription="Resolution" />

                <TextView
                    android:id="@+id/badgeResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_badge_apple_resolution"
                    android:paddingStart="6.5dp"
                    android:paddingEnd="6.5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="4K"
                    android:textColor="#18181E"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivPlayerHdr"
                    android:layout_width="wrap_content"
                    android:layout_height="17.5dp"
                    android:layout_marginStart="11dp"
                    android:alpha="0.90"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo_dolby_vision"
                    android:visibility="gone"
                    android:contentDescription="Dynamic Range" />

                <TextView
                    android:id="@+id/badgeHdr"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_cinema_outline"
                    android:paddingStart="6.5dp"
                    android:paddingEnd="6.5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="HLG"
                    android:textColor="#D8FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivPlayerAudioCarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="15.5dp"
                    android:layout_marginStart="11dp"
                    android:alpha="0.90"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo_dolby_truehd"
                    android:visibility="gone"
                    android:contentDescription="Audio Codec Carrier" />

                <ImageView
                    android:id="@+id/ivPlayerAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="17.5dp"
                    android:layout_marginStart="11dp"
                    android:alpha="0.90"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo_dolby_atmos"
                    android:visibility="gone"
                    android:contentDescription="Audio Format" />

                <TextView
                    android:id="@+id/badgeAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_cinema_outline"
                    android:paddingStart="6.5dp"
                    android:paddingEnd="6.5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="FLAC"
                    android:textColor="#D8FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/badgeChannels"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_cinema_outline"
                    android:paddingStart="6.5dp"
                    android:paddingEnd="6.5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="7.1"
                    android:textColor="#D8FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/badgeAfr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="24.000 Hz"
                    android:textColor="#B8FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:shadowColor="#B0000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- APPLE TV BOTTOM BAR WITH ULTRA-SLIM TIMELINE AND ACTIONS -->
        <LinearLayout
            android:id="@+id/bottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_bottom_gradient"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp"
            android:paddingTop="36dp">

            <!-- ROW 1: YEAR AND TITLE ON LEFT, SUBTITLES AND AUDIO ON RIGHT (EXACT APPLE TV STYLE) -->
            <LinearLayout
                android:id="@+id/llPlayerHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1981"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif" />

                    <ImageView
                        android:id="@+id/ivPlayerLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxHeight="52dp"
                        android:maxWidth="300dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        android:contentDescription="Title Logo" />

                    <TextView
                        android:id="@+id/tvPlayerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raiders of the Lost Ark"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="1dp" />

                    <!-- Current active chapter name on screen -->
                    <TextView
                        android:id="@+id/tvPlayerChapter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A0A0A5"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Diseño 11: Clean 10dp Squircle Subtitles and Audio Buttons (Play/Pause button removed) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageButton
                        android:id="@+id/btnSubtitles"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_subtitles"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@id/timelineSeekBar"
                        android:nextFocusRight="@id/btnAudioTrack"
                        android:nextFocusUp="@id/btnBack"
                        android:contentDescription="Subtitles" />

                    <ImageButton
                        android:id="@+id/btnAudioTrack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_audiotrack"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@id/timelineSeekBar"
                        android:nextFocusLeft="@id/btnSubtitles"
                        android:nextFocusUp="@id/btnBack"
                        android:contentDescription="Audio" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: FULL WIDTH PROGRESS BAR WITH APPLE TV CHAPTER TICKS -->
            <FrameLayout
                android:id="@+id/flTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="8dp">

                <SeekBar
                    android:id="@+id/timelineSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="1000"
                    android:progress="0"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:thumbOffset="1.5dp"
                    android:background="@null"
                    android:defaultFocusHighlightEnabled="false"
                    android:progressDrawable="@drawable/seekbar_progress_apple"
                    android:thumb="@drawable/seekbar_thumb_apple"
                    android:splitTrack="false"
                    android:focusable="true"
                    android:nextFocusDown="@id/btnChapters"
                    android:nextFocusUp="@id/btnSubtitles">
                    <requestFocus />
                </SeekBar>

                <!-- Chapter notch separators across progress bar -->
                <com.player.androidtv.ChapterTicksView
                    android:id="@+id/chapterTicksView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- ROW OF TIMESTAMPS BELOW PROGRESS BAR (Apple TV Style) -->
            <RelativeLayout
                android:id="@+id/rlTimeBelowBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <!-- Remaining time anchored at far right under progress bar (-xx:xx:xx) -->
                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="-00:00:00"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:fontFeatureSettings="tnum"
                    android:fontFamily="sans-serif" />

                <!-- Dynamic current time and speed badge container aligned with timeline needle -->
                <LinearLayout
                    android:id="@+id/llScrubTimeBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Box-free Rewind speed / quick-skip text (Diseño 11: zero pill box) -->
                    <TextView
                        android:id="@+id/tvScrubSpeedLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text=""
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"
                        android:shadowColor="#B0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:visibility="gone" />

                    <!-- Current time / scrub position -->
                    <TextView
                        android:id="@+id/tvScrubTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-bold" />

                    <!-- Box-free Fast forward speed / quick-skip text (Diseño 11: zero pill box) -->
                    <TextView
                        android:id="@+id/tvScrubSpeedRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"
                        android:shadowColor="#B0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:visibility="gone" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Action Pills on the Left -->
            <LinearLayout
                android:id="@+id/llActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnChapters"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Chapters"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusRight="@id/btnDvMode" />

                <Button
                    android:id="@+id/btnDvMode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Dolby Vision P8.1"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusLeft="@id/btnChapters" />
            </LinearLayout>

        </LinearLayout>

        <!-- APPLE TV FLOATING FRAME PREVIEW CONTAINER AND CONTINUOUS NEEDLE PIN -->
        <FrameLayout
            android:id="@+id/llScrubPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:elevation="28dp"
            android:visibility="gone">

            <!-- Rounded 14dp widescreen 16:9 preview window (220x124dp) Apple TV style -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvScrubCard"
                android:layout_width="220dp"
                android:layout_height="124dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#14141A"
                android:clipToOutline="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToOutline="true">

                    <!-- Real Scene Keyframe Thumbnail -->
                    <ImageView
                        android:id="@+id/ivScrubThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Preview Thumbnail" />

                    <!-- Subtle aesthetic Apple TV border (transparent with 1.5dp stroke, 14dp radius) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_apple_tv_scrub_card" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Box-Free Speed Label Floating Centered Above Preview Card (Diseño 11: e.g. '1× ▸', '◂◂ 2×') -->
            <TextView
                android:id="@+id/tvScrubSpeedAboveCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="1× ▸"
                android:visibility="gone" />

            <!-- Chapter title softly above speed label -->
            <TextView
                android:id="@+id/tvScrubChapterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D0FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="Chapter 1"
                android:visibility="gone" />

            <!-- CONTINUOUS VERTICAL NEEDLE / PIN LINE (100% Apple TV) -->
            <View
                android:id="@+id/vScrubPinLine"
                android:layout_width="2.5dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_apple_tv_scrub_needle" />
        </FrameLayout>
    </RelativeLayout>

    <!-- BRIEF CENTER-SCREEN PLAY / PAUSE INDICATOR (Requirement #1) -->
    <FrameLayout
        android:id="@+id/centerPlayPauseIndicator"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_tvos_live_popup"
        android:elevation="26dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCenterPlayPauseIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:tint="#FFFFFF"
            android:contentDescription="Playback State" />
    </FrameLayout>

    <!-- TRUE LIVE SEMI-TRANSPARENT POPUP OVER PLAYING VIDEO (Requirement #3: Zero frozen snapshot) -->
    <FrameLayout
        android:id="@+id/modalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/modalCard"
            android:layout_width="276dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="186dp"
            android:clickable="true"
            android:focusable="false"
            android:background="@drawable/bg_tvos_live_popup"
            android:orientation="vertical"
            android:padding="14dp"
            android:elevation="24dp">

            <!-- Apple TV Popup Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvModalTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtitles"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvModalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOLBY ATMOS"
                    android:textColor="#A1A1A6"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Track List in ScrollView -->
            <com.player.androidtv.MaxHeightScrollView
                android:id="@+id/modalScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:requiresFadingEdge="none">

                <LinearLayout
                    android:id="@+id/llModalListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.player.androidtv.MaxHeightScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- APPLE TV MINIMAL LOADING SPINNER -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>

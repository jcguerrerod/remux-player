<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPlaybackContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- NATIVE VIDEO SURFACE (MediaCodec Hardware Surface) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- APPLE TV+ / tvOS MINIMAL HUD OVERLAY -->
    <RelativeLayout
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APPLE TV SUBTLE TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_top_gradient"
            android:paddingStart="48dp"
            android:paddingTop="28dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <!-- 40dp Circular Back Button (Zero scale zoom) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_apple_tv_circle_button"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/apple_btn_tint_selector"
                android:focusable="true"
                android:nextFocusDown="@id/timelineSeekBar"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvTopHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="REMUX PLAYER"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <!-- Apple TV Unified Vector Technology Pills -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Resolution Pill: 4K or HD -->
                <TextView
                    android:id="@+id/badgeResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_apple_tv_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="4K"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06" />

                <!-- HDR / Dolby Vision Pill -->
                <TextView
                    android:id="@+id/badgeHdr"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_apple_tv_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="DOLBY VISION"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05" />


                <!-- Audio Codec Pill: DOLBY ATMOS / DTS-HD MA / DOLBY AUDIO / TRUEHD / PCM -->
                <TextView
                    android:id="@+id/badgeAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_apple_tv_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="DOLBY ATMOS"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05" />

                <!-- Audio Channels Pill: 5.1 / 7.1 / 2.0 -->
                <TextView
                    android:id="@+id/badgeChannels"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_apple_tv_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="7.1"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.05" />

                <!-- AFR Frame Rate Pill -->
                <TextView
                    android:id="@+id/badgeAfr"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_apple_tv_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="24.000 Hz AFR"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- APPLE TV BOTTOM BAR WITH ULTRA-SLIM TIMELINE AND ACTIONS -->
        <LinearLayout
            android:id="@+id/bottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_bottom_gradient"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp"
            android:paddingTop="36dp">

            <!-- ROW 1: YEAR AND TITLE ON LEFT, SUBTITLES AND AUDIO ON RIGHT (EXACT APPLE TV STYLE) -->
            <LinearLayout
                android:id="@+id/llPlayerHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1981"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvPlayerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raiders of the Lost Ark"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="1dp" />

                    <!-- Current active chapter name on screen -->
                    <TextView
                        android:id="@+id/tvPlayerChapter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A0A0A5"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 40dp Circular Subtitles and Audio Buttons Above Progress Bar -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageButton
                        android:id="@+id/btnSubtitles"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_subtitles"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@id/timelineSeekBar"
                        android:nextFocusRight="@id/btnAudioTrack"
                        android:nextFocusUp="@id/btnBack"
                        android:contentDescription="Subtitles" />

                    <ImageButton
                        android:id="@+id/btnAudioTrack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_apple_tv_circle_button"
                        android:src="@drawable/ic_audiotrack"
                        android:tint="@color/apple_btn_tint_selector"
                        android:focusable="true"
                        android:nextFocusDown="@id/timelineSeekBar"
                        android:nextFocusLeft="@id/btnSubtitles"
                        android:nextFocusUp="@id/btnBack"
                        android:contentDescription="Audio" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: FULL WIDTH PROGRESS BAR WITH APPLE TV CHAPTER TICKS -->
            <FrameLayout
                android:id="@+id/flTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="8dp">

                <SeekBar
                    android:id="@+id/timelineSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="1000"
                    android:progress="0"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:thumbOffset="1.5dp"
                    android:background="@null"
                    android:defaultFocusHighlightEnabled="false"
                    android:progressDrawable="@drawable/seekbar_progress_apple"
                    android:thumb="@drawable/seekbar_thumb_apple"
                    android:splitTrack="false"
                    android:focusable="true"
                    android:nextFocusDown="@id/btnInfo"
                    android:nextFocusUp="@id/btnSubtitles">
                    <requestFocus />
                </SeekBar>

                <!-- Chapter notch separators across progress bar -->
                <com.player.androidtv.ChapterTicksView
                    android:id="@+id/chapterTicksView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- ROW OF TIMESTAMPS BELOW PROGRESS BAR (Apple TV Style) -->
            <RelativeLayout
                android:id="@+id/rlTimeBelowBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <!-- Remaining time anchored at far right under progress bar (-xx:xx:xx) -->
                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="-00:00:00"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:fontFeatureSettings="tnum"
                    android:fontFamily="sans-serif" />

                <!-- Dynamic current time and speed badge container aligned with timeline needle -->
                <LinearLayout
                    android:id="@+id/llScrubTimeBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Rewind speed / quick-skip badge on the LEFT (e.g. -10s or 1x, 2x) -->
                    <TextView
                        android:id="@+id/tvScrubSpeedLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_scrub_speed_badge"
                        android:text="-10s"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />

                    <!-- Current time / scrub position -->
                    <TextView
                        android:id="@+id/tvScrubTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Fast forward speed / quick-skip badge on the RIGHT (e.g. +10s or 1x, 2x) -->
                    <TextView
                        android:id="@+id/tvScrubSpeedRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_scrub_speed_badge"
                        android:text="+10s"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ROW 3: APPLE TV PILL ACTIONS (Info, Chapters, Dolby Vision, Library) -->
            <LinearLayout
                android:id="@+id/llActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Action Pills on the Left -->
                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Info"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusRight="@id/btnChapters" />

                <Button
                    android:id="@+id/btnChapters"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Chapters"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusLeft="@id/btnInfo"
                    android:nextFocusRight="@id/btnDvMode" />

                <Button
                    android:id="@+id/btnDvMode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Dolby Vision P8.1"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusLeft="@id/btnChapters"
                    android:nextFocusRight="@id/btnLibrary" />

                <Button
                    android:id="@+id/btnLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_apple_tv_pill_secondary"
                    android:text="Library"
                    android:textColor="@color/apple_btn_text_selector"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/timelineSeekBar"
                    android:nextFocusLeft="@id/btnDvMode" />
            </LinearLayout>

        </LinearLayout>

        <!-- APPLE TV FLOATING FRAME PREVIEW CONTAINER AND CONTINUOUS NEEDLE PIN -->
        <FrameLayout
            android:id="@+id/llScrubPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:elevation="28dp"
            android:visibility="gone">

            <!-- Rounded 12dp widescreen 16:9 preview window (220x124dp) Apple TV style -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvScrubCard"
                android:layout_width="220dp"
                android:layout_height="124dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardMaxElevation="6dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#000000">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Real Scene Keyframe Thumbnail -->
                    <ImageView
                        android:id="@+id/ivScrubThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Preview Thumbnail" />

                    <!-- Subtle aesthetic Apple TV border (transparent with 1.5dp stroke) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_apple_tv_scrub_card" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Chapter pill above the preview card -->
            <TextView
                android:id="@+id/tvScrubChapterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_apple_tv_chapter_pill"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:text="Chapter 1"
                android:visibility="gone" />

            <!-- CONTINUOUS VERTICAL NEEDLE / PIN LINE (100% Apple TV) -->
            <View
                android:id="@+id/vScrubPinLine"
                android:layout_width="2.5dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_apple_tv_scrub_needle" />
        </FrameLayout>
    </RelativeLayout>

    <!-- FLOATING POPUP ANCHORED OVER ACTION BUTTONS (Apple TV Style) -->
    <FrameLayout
        android:id="@+id/modalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Frosted Liquid Glass Sheet Anchored Over Buttons -->
        <LinearLayout
            android:id="@+id/modalCard"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="186dp"
            android:clickable="true"
            android:focusable="false"
            android:background="@drawable/bg_apple_tv_sheet"
            android:orientation="vertical"
            android:padding="14dp"
            android:elevation="24dp">

            <!-- Apple TV Popup Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvModalTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtitles"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvModalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOLBY ATMOS"
                    android:textColor="#A1A1A6"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Track List in ScrollView (No scrollbars and safe maxHeight limit) -->
            <com.player.androidtv.MaxHeightScrollView
                android:id="@+id/modalScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:requiresFadingEdge="none">

                <LinearLayout
                    android:id="@+id/llModalListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.player.androidtv.MaxHeightScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- APPLE TV MINIMAL LOADING SPINNER -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>

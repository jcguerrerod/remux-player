<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llTrackItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_apple_tv_sheet_item"
    android:focusable="true"
    android:clickable="true"
    android:paddingStart="11dp"
    android:paddingTop="7.5dp"
    android:paddingEnd="11dp"
    android:paddingBottom="7.5dp"
    android:layout_marginTop="1.5dp"
    android:layout_marginBottom="1.5dp">

    <!-- Checkmark Icon (Visible when active) -->
    <ImageView
        android:id="@+id/ivTrackCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_check"
        android:tint="@color/apple_sheet_text_selector"
        android:layout_marginEnd="8dp"
        android:duplicateParentState="true"
        android:visibility="invisible"
        android:contentDescription="Selected" />

    <!-- Track Title and Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Title"
            android:textColor="@color/apple_sheet_text_selector"
            android:textSize="12.5sp"
            android:duplicateParentState="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTrackSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technical Details"
            android:textColor="@color/apple_sheet_subtext_selector"
            android:textSize="10.5sp"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Badges enriquecidos estilo Apple TV (Primario y Secundario) -->
    <LinearLayout
        android:id="@+id/llTrackBadges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true">

        <!-- Badge Secundario (Canales / Rol: 7.1, 5.1, FORZADOS, CC) -->
        <TextView
            android:id="@+id/tvTrackBadgeSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_apple_tv_sheet_badge"
            android:textColor="@color/apple_sheet_text_selector"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:paddingStart="5.5dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="5.5dp"
            android:paddingBottom="1.5dp"
            android:layout_marginEnd="4dp"
            android:duplicateParentState="true"
            android:visibility="gone" />

        <!-- Primary Badge (Format / Codec: DOLBY ATMOS, TRUEHD, DTS-HD, PGS, etc.) -->
        <TextView
            android:id="@+id/tvTrackBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_apple_tv_sheet_badge_highlight"
            android:textColor="@color/apple_sheet_text_selector"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:paddingStart="6.5dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="6.5dp"
            android:paddingBottom="1.5dp"
            android:duplicateParentState="true"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

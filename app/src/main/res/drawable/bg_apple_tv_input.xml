<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tvos_glass_row_focused" />
            <stroke android:width="2dp" android:color="@color/tvos_rim_focus" />
            <padding
                android:left="16dp"
                android:top="11dp"
                android:right="16dp"
                android:bottom="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tvos_glass_row_idle" />
            <stroke android:width="1dp" android:color="@color/tvos_rim_subtle" />
            <padding
                android:left="16dp"
                android:top="11dp"
                android:right="16dp"
                android:bottom="11dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Caída ambiental suave de rango completo (0% a 100% de altura) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#8006080E"
                android:centerColor="#3006080E"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 2: Densidad media con suavizado cúbico (0% a 65% de altura) -->
    <item android:top="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#B806080E"
                android:centerColor="#4D06080E"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 3: Anclaje de alto contraste en el tercio inferior para lectura perfecta (0% a 35%) -->
    <item android:top="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F506080E"
                android:centerColor="#8006080E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>

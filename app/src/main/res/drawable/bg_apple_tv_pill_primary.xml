<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFF"
                        android:endColor="#F2F2F7"
                        android:type="linear" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                    <padding
                        android:left="24dp"
                        android:top="12dp"
                        android:right="24dp"
                        android:bottom="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#D8D8DF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="24dp"
                android:top="12dp"
                android:right="24dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="300"
                        android:startColor="#48FFFFFF"
                        android:centerColor="#28FFFFFF"
                        android:endColor="#1AFFFFFF"
                        android:type="linear" />
                    <stroke android:width="1.2dp" android:color="#66FFFFFF" />
                    <padding
                        android:left="24dp"
                        android:top="12dp"
                        android:right="24dp"
                        android:bottom="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

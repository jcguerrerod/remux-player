<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2A2F45" />
            <stroke android:width="2dp" android:color="#38EF7D" />
            <padding android:left="14dp" android:top="6dp" android:right="14dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#80151824" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <padding android:left="14dp" android:top="6dp" android:right="14dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#F2F2F7"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#D1D1D6" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#58FFFFFF"
                android:endColor="#32FFFFFF"
                android:type="linear" />
            <stroke android:width="1.6dp" android:color="#B8FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="300"
                android:startColor="#3BFFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
            <stroke android:width="1.1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</selector>

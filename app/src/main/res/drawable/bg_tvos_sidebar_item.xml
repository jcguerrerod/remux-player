<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused sidebar item: Crisp White Pill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/tvos_white_focus" />
        </shape>
    </item>
    <!-- Active tab when unfocused: Soft luminous glass pill -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#2EFFFFFF" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
        </shape>
    </item>
    <!-- Idle -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>

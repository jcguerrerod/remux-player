<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="72dp">
                <shape android:shape="rectangle">
                    <corners
                        android:bottomLeftRadius="10dp"
                        android:bottomRightRadius="10dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#8806080E"
                        android:endColor="#0006080E" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke android:width="2.2dp" android:color="@color/tvos_rim_focus" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="82dp">
                <shape android:shape="rectangle">
                    <corners
                        android:bottomLeftRadius="10dp"
                        android:bottomRightRadius="10dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#6606080E"
                        android:endColor="#0006080E" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="@color/tvos_rim_subtle" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft bottom-heavy vignette for crisp progress bar & text legibility -->
            <item android:top="72dp">
                <shape android:shape="rectangle">
                    <corners
                        android:bottomLeftRadius="16dp"
                        android:bottomRightRadius="16dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#8805060A"
                        android:endColor="#0005060A" />
                </shape>
            </item>
            <!-- Liquid Glass specular upper glint -->
            <item android:bottom="60dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="15dp"
                        android:topRightRadius="15dp" />
                    <gradient
                        android:angle="290"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- Pure crisp Apple TV white focus border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="84dp">
                <shape android:shape="rectangle">
                    <corners
                        android:bottomLeftRadius="16dp"
                        android:bottomRightRadius="16dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#6605060A"
                        android:endColor="#0005060A" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#30FFFFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

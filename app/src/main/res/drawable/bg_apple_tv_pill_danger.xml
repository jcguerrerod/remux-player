<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FF453A" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#30FF453A" />
            <stroke android:width="1dp" android:color="#80FF453A" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
</selector>

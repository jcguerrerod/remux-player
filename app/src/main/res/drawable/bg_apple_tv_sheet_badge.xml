<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/tvos_badge_dark_fill" />
            <stroke android:width="1dp" android:color="@color/tvos_badge_dark_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/tvos_badge_fill" />
            <stroke android:width="1dp" android:color="@color/tvos_badge_stroke" />
        </shape>
    </item>
</selector>

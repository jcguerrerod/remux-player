<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#D1D1D6" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#2DFFFFFF"
                android:endColor="#18FFFFFF"
                android:type="linear" />
            <stroke android:width="1.2dp" android:color="#42FFFFFF" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
</selector>

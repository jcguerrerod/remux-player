<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#F2F2F7"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#D1D1D6" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:endColor="#33FFFFFF"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#A8FFFFFF" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="300"
                android:startColor="#34FFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
            <stroke android:width="1.1dp" android:color="#50FFFFFF" />
            <padding
                android:left="18dp"
                android:top="9dp"
                android:right="18dp"
                android:bottom="9dp" />
        </shape>
    </item>
</selector>

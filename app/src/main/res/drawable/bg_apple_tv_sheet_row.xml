<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Episode Card Row inside Bottom Drawer: Graphite Glass + Crisp 2dp White Rim when Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tvos_glass_row_focused" />
            <stroke android:width="2dp" android:color="@color/tvos_rim_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tvos_glass_row_idle" />
            <stroke android:width="1dp" android:color="@color/tvos_rim_subtle" />
        </shape>
    </item>
</selector>

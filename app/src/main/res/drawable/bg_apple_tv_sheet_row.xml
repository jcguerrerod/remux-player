<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="300"
                        android:startColor="#42FFFFFF"
                        android:endColor="#24FFFFFF"
                        android:type="linear" />
                    <stroke android:width="1.6dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#1EFFFFFF"
                android:endColor="#10FFFFFF"
                android:type="linear" />
            <stroke android:width="0.9dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>

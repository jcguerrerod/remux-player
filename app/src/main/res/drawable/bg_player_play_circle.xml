<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#4F46E5"
                android:endColor="#7C3AED" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#3730A3" />
            <stroke android:width="2dp" android:color="#A5B4FC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#50312E81"
                android:endColor="#504338CA" />
            <stroke android:width="1.5dp" android:color="#60818CF8" />
        </shape>
    </item>
</selector>
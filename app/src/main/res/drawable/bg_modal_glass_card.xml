<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent Liquid Obsidian Body (30% opacity) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#541E2638"
                android:centerColor="#38121826"
                android:endColor="#440A0E1A"
                android:type="linear" />
            <corners android:radius="26dp" />
            <stroke android:width="1.2dp" android:color="#78FFFFFF" />
        </shape>
    </item>
</layer-list>
